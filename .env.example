# 살펴 백엔드 (artinfo-server) 주소. 비워두면 시설 목록이 비어 있습니다 (시설 데이터는 백엔드의 공공데이터 시드가 원천).
# 운영: https://api-artinfokorea.com  (Swagger: https://api-artinfokorea.com/api-docs)
# 로컬 백엔드: artinfo-server 에서 `SALPYEO_REPOSITORY=memory PORT=4000 npx ts-node -r tsconfig-paths/register src/salpyeo/salpyeo-standalone.ts` 후 http://localhost:4000
SALPYEO_API_URL=https://api-artinfokorea.com

# 브라우저에서 부르는 주소 (로그인 요청). 서버 전용 SALPYEO_API_URL 과 같은 백엔드를 가리키면 된다.
NEXT_PUBLIC_SALPYEO_API_URL=https://api-artinfokorea.com

# Google Cloud 콘솔의 "웹 애플리케이션" OAuth 클라이언트 ID — 없으면 로그인 버튼이 숨겨진다.
# 승인된 JavaScript 원본에 사이트 주소(로컬은 http://localhost:3000)를 등록해야 하며,
# 리디렉션을 쓰지 않는 방식이라 클라이언트 보안 비밀번호(client secret)는 필요 없다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 사이트 절대 주소 — canonical·sitemap·og:image 가 이 값을 쓴다.
# 비워 두면 https://salpyeo.com 을 쓴다 (src/lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://salpyeo.com
